<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>BikeHub — Interface v0.1</title>
<meta name="theme-color" content="#050B0E">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" href="assets/brand-bikehub.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="BikeHub">
<style>
:root{
  --bg:#050B0E;--surface:#0B1519;--surface2:#111D22;--line:#26363B;
  --text:#F6F7F5;--muted:#93A0A4;--green:#9BE318;--green2:#79C20E;
  --warning:#FFB020;--danger:#FF6464;--info:#67B7FF;--shadow:0 22px 70px rgba(0,0,0,.35)
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:
radial-gradient(circle at 78% 0,rgba(155,227,24,.07),transparent 26rem),var(--bg);
color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
button,input,select{font:inherit}
button{cursor:pointer}
.hidden{display:none!important}
svg{display:block}
.brand{display:flex;align-items:center;gap:11px;font-weight:900;letter-spacing:-1px;font-size:27px}
.brand-word b{color:var(--green)}
.chain-mark{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;
background:linear-gradient(145deg,rgba(155,227,24,.16),rgba(155,227,24,.05));
border:1px solid rgba(155,227,24,.28);box-shadow:inset 0 0 25px rgba(155,227,24,.04)}
.chain-mark svg{width:25px;height:25px;color:var(--green)}
.btn{min-height:48px;border-radius:11px;padding:0 20px;border:1px solid transparent;font-weight:800;
display:inline-flex;align-items:center;justify-content:center;gap:9px;transition:.2s ease}
.btn:hover{transform:translateY(-1px)}
.btn.primary{background:linear-gradient(135deg,var(--green),var(--green2));color:#061004;box-shadow:0 10px 28px rgba(121,194,14,.18)}
.btn.secondary{background:transparent;border-color:#536267;color:white}
.btn.ghost{background:#101C20;border-color:#2E4046;color:white}
.btn.full{width:100%}
.icon-btn{width:42px;height:42px;border-radius:11px;border:1px solid #324349;background:#0B171B;color:white;display:grid;place-items:center}
.badge{display:inline-flex;align-items:center;gap:6px;border-radius:99px;padding:5px 9px;font-size:10px;font-weight:800}
.badge.green{background:#9be31819;color:var(--green);border:1px solid #9be31833}
.badge.purple{background:#5B2E77;color:white}
.eyebrow{color:var(--green);font-weight:800;letter-spacing:.13em;font-size:12px}
#access{min-height:100vh;display:grid;grid-template-columns:minmax(430px,1fr) 1.1fr}
.access-copy{padding:clamp(36px,6vw,92px);display:flex;flex-direction:column;justify-content:center}
.access-copy .eyebrow{margin-top:90px}
.access-copy h1{font-size:clamp(49px,6vw,82px);line-height:.95;letter-spacing:-.06em;margin:15px 0 22px}
.access-copy h1 em{font-style:normal;color:var(--green)}
.access-copy p{color:#B0BABC;font-size:18px;line-height:1.7;max-width:660px}
.features{display:flex;flex-wrap:wrap;gap:13px 20px;margin:22px 0 30px;color:#D9DFDC}
.features span{display:flex;align-items:center;gap:8px}
.features svg{width:18px;color:var(--green)}
.actions{display:flex;gap:12px;flex-wrap:wrap}
.access-art{position:relative;overflow:hidden;min-height:100vh;background:linear-gradient(#192E35,#6D5839 65%,#10191A)}
.sun{position:absolute;width:165px;height:165px;border-radius:50%;background:#E7AD4D;top:16%;right:18%;box-shadow:0 0 85px #E7AD4D88}
.mountain1,.mountain2{position:absolute;left:-10%;right:-10%;bottom:0}
.mountain1{height:58%;background:#162326;clip-path:polygon(0 72%,15% 50%,28% 62%,45% 25%,60% 55%,74% 36%,100% 67%,100% 100%,0 100%)}
.mountain2{height:44%;background:#081114;clip-path:polygon(0 80%,20% 62%,39% 74%,62% 47%,82% 70%,100% 58%,100% 100%,0 100%)}
.hero-panel{position:absolute;left:8%;right:8%;bottom:7%;padding:30px;border-radius:28px;background:#061014dd;
border:1px solid rgba(255,255,255,.17);backdrop-filter:blur(12px);display:flex;gap:24px;align-items:center;box-shadow:var(--shadow)}
.hero-chain{width:90px;height:90px;border-radius:25px;display:grid;place-items:center;background:#9be31812;border:1px solid #9be31833;color:var(--green)}
.hero-chain svg{width:52px;height:52px}
.hero-panel strong{font-size:30px;display:block}
.hero-panel span{color:#AEB8BA;display:block;margin-top:8px}
#login{min-height:100vh;display:grid;place-items:center;padding:24px}
.login-card{width:min(470px,100%);background:linear-gradient(145deg,var(--surface),#081316);border:1px solid var(--line);
border-radius:24px;padding:30px;box-shadow:var(--shadow)}
.login-card h1{font-size:34px;margin:30px 0 5px}
.login-card p{color:var(--muted);line-height:1.6}
.demo{padding:15px;border:1px solid #344347;border-radius:13px;background:var(--surface2);color:#D2D8D6;margin:20px 0}
.demo strong{color:var(--green)}
.login-card label{display:grid;gap:7px;margin:14px 0;font-size:13px;font-weight:700}
.login-card input{min-height:48px;background:#071114;border:1px solid #354448;border-radius:9px;color:white;padding:0 14px;outline:0}
.login-card input:focus{border-color:var(--green);box-shadow:0 0 0 3px #9be31812}
.error{padding:10px;border-radius:8px;background:#ff525218;border:1px solid #ff525244;color:#FF9A9A;margin:12px 0}

.shell{display:flex;min-height:100vh}
.sidebar{position:fixed;inset:0 auto 0 0;width:265px;background:#040C0F;border-right:1px solid #253438;padding:22px 13px;overflow:auto;z-index:30}
.profile{display:flex;gap:11px;align-items:center;margin:27px 4px 23px}
.avatar{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,var(--green2),var(--green));display:grid;place-items:center;color:#061004;font-weight:900;border:3px solid #D8E8BD}
.profile small{display:block;color:var(--muted);margin-top:4px}
.nav{display:grid;gap:4px}
.nav button{width:100%;min-height:43px;border:0;border-radius:9px;background:transparent;color:#D7DDDB;text-align:left;padding:0 12px;display:flex;align-items:center;gap:10px}
.nav button svg{width:19px;height:19px}
.nav button.active{background:linear-gradient(90deg,#4C7210,#749F15);color:white}
.nav button.locked{color:#657275;cursor:not-allowed}
.nav button.locked:after{content:"em breve";margin-left:auto;font-size:9px}
.pro-card{margin-top:20px;padding:16px;border-radius:14px;background:linear-gradient(145deg,#16231E,#091316);border:1px solid #334037}
.pro-card strong{color:var(--green)}
.pro-card p{color:var(--muted);font-size:11px;line-height:1.5;margin-bottom:0}
.main{margin-left:265px;width:calc(100% - 265px)}
.topbar{height:76px;padding:0 24px;border-bottom:1px solid #263438;display:flex;align-items:center;justify-content:flex-end;gap:12px;position:sticky;top:0;z-index:20;background:#061014e8;backdrop-filter:blur(12px)}
.search{width:330px;height:43px;border:1px solid #344347;border-radius:10px;padding:0 14px;display:flex;align-items:center;gap:9px;color:var(--muted)}
.search svg{width:18px}
.points{height:43px;border:1px solid #659810;border-radius:10px;padding:0 14px;display:flex;align-items:center;gap:7px;color:var(--green);font-weight:900}
.page{padding:28px;max-width:1540px;margin:auto;animation:fade .22s ease}
@keyframes fade{from{opacity:.35;transform:translateY(4px)}to{opacity:1;transform:none}}
.page-header{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:22px}
.page h1{font-size:32px;letter-spacing:-1px;margin:0 0 4px}
.subtitle{color:var(--muted);margin:0}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px}
.stat,.card{background:linear-gradient(145deg,var(--surface),#081316);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:0 10px 35px rgba(0,0,0,.12)}
.stat{display:flex;gap:14px;min-height:135px}
.stat .ico{color:var(--green)}
.stat .ico svg{width:24px;height:24px}
.stat b{display:block;font-size:27px;margin:8px 0 4px}
.stat small{color:var(--muted)}
.progress{height:5px;border-radius:10px;background:#273336;overflow:hidden;margin-top:15px}
.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--green2),var(--green))}
.dashboard-grid{display:grid;grid-template-columns:1fr 1fr .82fr;gap:12px;align-items:start}
.card header{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.card h2{font-size:16px;margin:0}
.card header button{background:none;border:0;color:var(--green)}
.row{display:flex;align-items:center;gap:11px;padding:12px 0;border-bottom:1px solid #263438}
.row:last-child{border:0}
.row .ico{color:var(--green)}
.row .ico svg{width:20px;height:20px}
.row div{flex:1}
.row strong,.row small{display:block}
.row small{color:var(--muted);margin-top:3px}
.row time{color:#788588;font-size:10px}
.chart{height:170px;display:flex;align-items:flex-end;gap:6px;border-left:1px solid #304044;border-bottom:1px solid #304044;padding:10px}
.chart i{flex:1;background:linear-gradient(var(--green),#507A0A);border-radius:5px 5px 0 0}
.bike-card{grid-row:span 2}
.bike-art{height:220px;display:grid;place-items:center;background:radial-gradient(circle,#9be31812,transparent 60%)}
.bike-art svg{width:170px;height:170px;color:#D2D9D6}
.tags{display:flex;gap:7px;flex-wrap:wrap}
.tags span{border:1px solid #354448;border-radius:99px;padding:5px 8px;color:#AAB4B6;font-size:11px}
.recs{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.rec{min-height:155px;border-radius:12px;padding:15px;display:flex;flex-direction:column}
.rec strong{font-size:18px}.rec span{font-size:12px;color:#D1D4D7;margin-top:6px}.rec button{margin-top:auto;align-self:flex-start;border:1px solid #ffffff55;background:#0003;color:white;border-radius:7px;padding:7px 9px}
.r1{background:linear-gradient(145deg,#3C265D,#17122C)}.r2{background:linear-gradient(145deg,#153D65,#0D1A2C)}.r3{background:linear-gradient(145deg,#395E0A,#172707)}
.tabs{display:flex;gap:8px;border-bottom:1px solid #29373B;margin:18px 0;overflow:auto}
.tabs button{background:none;border:0;color:#9AA6A8;padding:13px;white-space:nowrap}
.tabs button.active{color:var(--green);border-bottom:2px solid var(--green)}
.bike-layout{display:grid;grid-template-columns:1.6fr .9fr;gap:12px}
.bike-main,.bike-side{display:grid;gap:12px}
.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:15px}
.metric b{display:block;font-size:18px}.metric small{color:var(--muted)}
.component{display:grid;grid-template-columns:30px 1fr auto auto;gap:8px;align-items:center;padding:11px 0;border-bottom:1px solid #29373B}
.component em{font-style:normal;color:var(--green)}.component em.warn{color:var(--warning)}
.locked-panel{min-height:450px;border:1px dashed #3A494D;border-radius:18px;display:grid;place-items:center;align-content:center;text-align:center;color:var(--muted);padding:30px}
.module-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.module-card{min-height:210px;display:flex;flex-direction:column}
.module-card .module-icon{width:52px;height:52px;border-radius:15px;background:#9be31812;border:1px solid #9be31833;display:grid;place-items:center;color:var(--green)}
.module-card .module-icon svg{width:26px;height:26px}
.module-card h3{margin:18px 0 8px}
.module-card p{color:var(--muted);font-size:13px;line-height:1.55}
.module-card .module-meta{margin-top:auto;display:flex;justify-content:space-between;align-items:center}
.list-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:12px}
.office-list,.event-list,.benefit-list{display:grid;gap:10px}
.office-item,.event-item,.benefit-item{display:flex;gap:14px;align-items:center;padding:14px;border:1px solid #2C3C41;background:#0D191D;border-radius:13px}
.office-logo,.event-date,.benefit-logo{width:58px;height:58px;border-radius:14px;background:#152429;display:grid;place-items:center;color:var(--green);font-weight:900}
.office-item div:nth-child(2),.event-item div:nth-child(2),.benefit-item div:nth-child(2){flex:1}
.office-item small,.event-item small,.benefit-item small{display:block;color:var(--muted);margin-top:4px}
.market-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.product{overflow:hidden;padding:0}
.product-visual{height:160px;background:linear-gradient(145deg,#152429,#0A1316);display:grid;place-items:center}
.product-visual svg{width:88px;height:88px;color:#D2D9D6}
.product-body{padding:15px}
.product-body h3{margin:0 0 7px}
.product-body p{color:var(--muted);font-size:12px}
.map-mock{height:360px;position:relative;overflow:hidden;background:
linear-gradient(90deg,transparent 49%,#26383D 50%,transparent 51%),
linear-gradient(transparent 49%,#26383D 50%,transparent 51%),
#0C181C;background-size:80px 80px;border-radius:14px;border:1px solid #2B3B40}
.pin{position:absolute;width:34px;height:34px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--green);display:grid;place-items:center;box-shadow:0 8px 20px #0008}
.pin span{transform:rotate(45deg);color:#061004;font-weight:900}
.pin.p1{left:22%;top:31%}.pin.p2{left:52%;top:55%}.pin.p3{left:74%;top:22%}
.profile-grid{display:grid;grid-template-columns:340px 1fr;gap:12px}
.profile-card-big{text-align:center}
.avatar-big{width:110px;height:110px;border-radius:50%;background:linear-gradient(135deg,var(--green2),var(--green));display:grid;place-items:center;margin:0 auto 18px;color:#061004;font-weight:900;font-size:30px;border:5px solid #D8E8BD}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.field label{display:block;color:#C9D0CE;font-size:12px;margin-bottom:7px}
.field input,.field select{width:100%;height:46px;background:#071114;border:1px solid #354448;border-radius:9px;color:white;padding:0 13px}
.notice-list{display:grid;gap:9px}
.notice{display:flex;gap:12px;padding:14px;border:1px solid #2B3B40;border-radius:12px;background:#0D191D}
.notice.unread{border-color:#5C8815;background:#101C17}
.notice .notice-icon{width:42px;height:42px;border-radius:12px;background:#9be31812;color:var(--green);display:grid;place-items:center}
.notice div:nth-child(2){flex:1}
.notice small{color:var(--muted)}
.settings-list{display:grid;gap:10px}
.setting-row{display:flex;align-items:center;gap:13px;padding:15px;border:1px solid #2B3B40;border-radius:12px;background:#0D191D}
.setting-row div{flex:1}
.setting-row small{display:block;color:var(--muted);margin-top:4px}
.switch{width:46px;height:26px;border-radius:99px;background:#2D3A3E;padding:3px}
.switch.on{background:#5B850F}.switch i{display:block;width:20px;height:20px;border-radius:50%;background:white;transition:.2s}.switch.on i{transform:translateX(20px)}
.menu-mobile{display:none}

@media(max-width:1200px){
.stats{grid-template-columns:repeat(2,1fr)}
.dashboard-grid{grid-template-columns:1fr 1fr}
.bike-card{grid-row:auto}
.bike-layout{grid-template-columns:1fr}
.module-grid{grid-template-columns:repeat(2,1fr)}
.market-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:920px){
#access{grid-template-columns:1fr}.access-art{min-height:470px}
.sidebar{transform:translateX(-105%);transition:.25s ease;width:280px}
.sidebar.open{transform:translateX(0)}
.main{margin:0;width:100%}
.menu-mobile{display:grid;place-items:center;margin-right:auto}
.scrim{position:fixed;inset:0;background:#0009;z-index:25}
.topbar{padding:0 14px}
.search{display:none}
.profile-grid,.list-grid{grid-template-columns:1fr}
}
@media(max-width:650px){
.access-copy{padding:28px 22px 50px}.access-copy h1{font-size:48px}.actions{flex-direction:column}
.stats,.dashboard-grid,.module-grid,.market-grid{grid-template-columns:1fr}
.page{padding:18px 12px}
.metrics,.form-grid{grid-template-columns:1fr 1fr}
.recs{grid-template-columns:1fr}
.hero-panel{left:5%;right:5%;padding:22px}.hero-panel strong{font-size:24px}.hero-chain{width:72px;height:72px}
.page-header{align-items:flex-start}
}

.brand-image{
  width:214px;
  height:48px;
  overflow:hidden;
  border-radius:4px;
}
.brand-image img{
  display:block;
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:left center;
}
.sidebar .brand-image{width:218px;height:48px}
.login-card .brand-image{width:225px;height:50px}
.access-copy .brand-image{width:238px;height:53px}
.hero-chain{
  width:210px!important;
  height:74px!important;
  padding:10px 14px;
  border-radius:20px!important;
}
.hero-chain img{
  width:100%;
  height:100%;
  object-fit:contain;
}
.hero-panel{justify-content:flex-start}
.hero-panel>div:last-child{min-width:0}
.card,.stat,.office-item,.event-item,.benefit-item,.notice,.setting-row{
  transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease;
}
.card:hover,.stat:hover,.office-item:hover,.event-item:hover,.benefit-item:hover{
  border-color:#3a4d52;
  box-shadow:0 18px 48px rgba(0,0,0,.2);
}
.nav button:not(.locked):hover{background:#101f23}
.product:hover{transform:translateY(-3px)}
.btn:active{transform:translateY(0)}
.app-version{
  margin:10px 4px 0;
  color:#647175;
  font-size:10px;
  letter-spacing:.06em;
  text-transform:uppercase;
}
@media(max-width:650px){
  .access-copy .brand-image{width:210px;height:47px}
  .hero-chain{width:170px!important;height:64px!important}
  .hero-panel{flex-direction:column;align-items:flex-start}
}

</style>
</head>
<body>

<template id="icons">
</template>

<section id="access">
  <div class="access-copy">
    <div class="brand brand-image"><img src="assets/brand-bikehub.png" alt="BikeHub"></div>
    <div class="eyebrow">PLATAFORMA COMPLETA PARA CICLISTAS</div>
    <h1>Tudo que você e sua bike precisam, <em>em um só lugar.</em></h1>
    <p>Organize sua bicicleta, acompanhe manutenções e conecte-se ao ecossistema do ciclismo em uma única experiência digital.</p>
    <div class="features">
      <span><i data-icon="check"></i> Prontuário digital</span>
      <span><i data-icon="gift"></i> Benefícios exclusivos</span>
      <span><i data-icon="bike"></i> Gestão da sua bike</span>
    </div>
    <div class="actions">
      <button class="btn primary" onclick="quickLogin()">Entrar como Jhonatan Ilha <span>→</span></button>
      <button class="btn secondary" onclick="show('login')">Entrar com e-mail</button>
    </div>
  </div>
  <div class="access-art">
    <div class="sun"></div><div class="mountain1"></div><div class="mountain2"></div>
    <div class="hero-panel">
      <div class="hero-chain"><img src="assets/brand-bikehub.png" alt="BikeHub"></div>
      <div><strong>Sua jornada começa aqui.</strong><span>Mais organização, cuidado e conexão.</span></div>
    </div>
  </div>
</section>

<section id="login" class="hidden">
  <div class="login-card">
    <div class="brand brand-image"><img src="assets/brand-bikehub.png" alt="BikeHub"></div>
    <h1>Entrar</h1><p>Acesse com o usuário demonstrativo já cadastrado.</p>
    <div class="demo"><strong>Usuário demonstrativo</strong><br>E-mail: jhonatan@bikehub.com<br>Senha: BikeHub@2026</div>
    <label>E-mail<input id="email" value="jhonatan@bikehub.com"></label>
    <label>Senha<input id="password" type="password" value="BikeHub@2026"></label>
    <div id="loginError" class="error hidden"></div>
    <button class="btn primary full" onclick="login()">Entrar</button>
    <button class="btn secondary full" style="margin-top:10px" onclick="show('access')">Voltar</button>
  </div>
</section>

<section id="app" class="hidden">
<div id="scrim" class="scrim hidden" onclick="toggleMenu(false)"></div>
<div class="shell">
  <aside id="sidebar" class="sidebar">
    <div class="brand brand-image"><img src="assets/brand-bikehub.png" alt="BikeHub"></div>
    <div class="profile"><div class="avatar">JI</div><div><strong>Jhonatan Ilha</strong><small>Clube · Nível 2 · 1.250 pts</small></div></div>
    <div class="nav" id="nav">
      <button data-page="dashboard" class="active"><span data-icon="dashboard"></span>Dashboard</button>
      <button data-page="bike"><span data-icon="bike"></span>Minha Bike</button>
      <button data-page="club"><span data-icon="sparkles"></span>Clube do Ciclista</button>
      <button data-page="benefits"><span data-icon="gift"></span>Benefícios</button>
      <button data-page="workshops"><span data-icon="tool"></span>Oficinas</button>
      <button data-page="market"><span data-icon="bag"></span>Marketplace</button>
      <button data-page="events"><span data-icon="calendar"></span>Eventos</button>
      <button data-page="stations"><span data-icon="drop"></span>Estações</button>
      <button data-page="notifications"><span data-icon="bell"></span>Notificações</button>
      <button data-page="profile"><span data-icon="user"></span>Perfil</button>

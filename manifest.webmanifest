};
function renderIcons(){
 document.querySelectorAll('[data-icon]').forEach(el=>{const k=el.getAttribute('data-icon');if(icons[k])el.innerHTML=icons[k]})
}
const USER_EMAIL='jhonatan@bikehub.com',USER_PASSWORD='BikeHub@2026';
function show(id){['access','login','app'].forEach(x=>document.getElementById(x).classList.toggle('hidden',x!==id));window.scrollTo(0,0)}
function quickLogin(){localStorage.setItem('bikehub_logged','1');show('app');openPage('dashboard')}
function login(){const e=document.getElementById('email').value.trim().toLowerCase(),p=document.getElementById('password').value,box=document.getElementById('loginError');if(e===USER_EMAIL&&p===USER_PASSWORD){box.classList.add('hidden');quickLogin()}else{box.textContent='E-mail ou senha incorretos.';box.classList.remove('hidden')}}
function logout(){localStorage.removeItem('bikehub_logged');show('access')}
function openPage(id){
 document.querySelectorAll('.app-page').forEach(p=>p.classList.toggle('hidden',p.id!==id));
 document.querySelectorAll('#nav button[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===id));
 toggleMenu(false);window.scrollTo(0,0)
}
document.querySelectorAll('#nav button[data-page]').forEach(b=>b.addEventListener('click',()=>openPage(b.dataset.page)));
function bikeTab(name,btn){document.querySelectorAll('#bikeTabs button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');document.getElementById('bikeSummary').classList.toggle('hidden',name!=='Resumo');document.getElementById('bikeLocked').classList.toggle('hidden',name==='Resumo');document.getElementById('lockedTitle').textContent=name}
function toggleSwitch(el){el.classList.toggle('on')}
function toggleMenu(open){document.getElementById('sidebar').classList.toggle('open',open);document.getElementById('scrim').classList.toggle('hidden',!open)}
renderIcons();
if(localStorage.getItem('bikehub_logged')==='1'){show('app');openPage('dashboard')}
</script>
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => navigator.serviceWorker.register('./sw.js').catch(() => {}));
}
</script>
</body>
</html>